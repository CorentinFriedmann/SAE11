# ET4 : configuration non sensible de BookStack (ConfigMap générée par Kustomize).
# Les secrets (APP_KEY, DB_PASSWORD) sont dans le Secret "wiki-secrets", jamais ici.
#
# APP_URL : exactement l'adresse utilisée, en https et sans barre finale.
APP_URL=https://wiki.rhenatech.lab
APP_LANG=fr
APP_TIMEZONE=Europe/Paris
TZ=Europe/Paris
# Utilisateur interne de l'image linuxserver (abc) : uid/gid 1000
PUID=1000
PGID=1000
# Base de données (Service headless de la StatefulSet MariaDB)
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=bookstack
DB_USERNAME=bookstack
# B8 : pièces jointes jusqu'à 20 Mo (on laisse 25 Mo de marge, PHP suit dans php-local.ini)
FILE_UPLOAD_SIZE_LIMIT=25
# Sécurité : cookie de session uniquement en HTTPS, Traefik (réseau des pods k3s) est un proxy de confiance
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
# Sessions en base : permet de couper immédiatement les sessions d'un compte désactivé (B4)
SESSION_DRIVER=database
APP_PROXIES=10.42.0.0/16
# Aucun appel sortant vers Gravatar (pas d'accès Internet, RGPD)
AVATAR_URL=false
# Historique des révisions conservé par page
REVISION_LIMIT=50
# Courriels : journalisés tant que le serveur de test (option O3, Mailpit) n'est pas branché
MAIL_DRIVER=log
MAIL_FROM=wiki@rhenatech.lab
MAIL_FROM_NAME=Wiki Rhenatech
